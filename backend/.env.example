# Copy this file to `.env` and fill in keys to run LIVE.
# Leave MOCK_MODE=true (or leave keys blank) to run in offline demo mode.

MOCK_MODE=true

# Google Cloud Vision (enable the Vision API, create an API key)
GOOGLE_VISION_API_KEY=

# eBay Browse API (developer.ebay.com -> create an app -> Production keys)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
